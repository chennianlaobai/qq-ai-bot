# 复制此文件为 .env，然后填你自己的值。改完要重启后端才生效。
# 说明：只有「必填」三项是跑起来必须的，其余留注释即用默认值。

# ========== 必填：模型服务（OpenAI 兼容接口，换厂商只改这三行）==========
AI_API_KEY=
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_MODEL=deepseek-v4-flash-ga-260731

# ========== 可选：模型调用参数 ==========
# AI_TEMPERATURE=0.95      # 越高越发散不套路，低了会一本正经（0~2）
# AI_TIMEOUT=90            # 单次请求超时秒数
# AI_MAX_RETRIES=3         # 限流/5xx 的自动重试次数

# ========== 可选：计价（元 / 百万 tokens，用于用量统计）==========
# PRICE_IN=3.0
# PRICE_OUT=9.0
# PRICE_CACHE=0.1

# ========== 可选：短期上下文 ==========
# HISTORY_MAX=20           # 每群内存缓存多少条
# HISTORY_USE=8            # 回复时带最近几条（必须 <= HISTORY_MAX）
# MAX_LEN_PER_MSG=120      # 单条消息截断字数
# AT_WINDOW=20             # 被 @ 后多少秒内补图也算发给它

# ========== 可选：长期记忆 ==========
# MEM_CONSOLIDATE_EVERY=30 # 攒够多少条触发一次合并
# MEM_ARCHIVE_MAX_CHARS=800
# MEM_PENDING_KEEP=200

# ========== 可选：服务监听（要和 NapCat 里填的反向 WS 地址对得上）==========
# HOST=127.0.0.1
# PORT=8080

# ========== 可选：人设 / 回复记录 ==========
# BOT_NICKNAME=鲸鱼娘
# REPLY_LOG_MAX_BYTES=5242880   # 回复日志滚动阈值（字节）

# ========== 可选：回复怎么发 ==========
# 带换行的回复按行拆成多条发（像真人打字分两条，人设里「祝福语正经一句+皮一句」就靠这个落地）
# REPLY_SPLIT_LINES=true
# REPLY_LINE_GAP=0.6            # 两条之间停几秒
# REPLY_MENTION=false           # 回复要不要 @ 对方；默认 false（群里聊天不带 @ 更像真人）

# ========== 必填（想用定时任务的话）：推送群号 ==========
# 课表本身在 timetable.json 里改，不用碰代码
TARGET_GROUP=
# REMIND_BEFORE=20         # 课前提前多少分钟提醒

# ========== 可选：群白名单（留空 = 不限制）==========
# ALLOW_GROUPS=<群号1>,<群号2>
